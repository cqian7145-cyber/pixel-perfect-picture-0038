# Moonlight Memories · 环境变量示例
#
# 用法：复制为 .env（本地）或 .env.<mode>，填入真实值；这些文件已在 .gitignore 中。
# 本文件只允许出现“变量名 + 占位值”，任何真实密钥、令牌、数据库密码都不得提交。
# 当前版本（MEM-001A）仍运行在浏览器 localStorage 演示数据上，因此以下变量暂时都不会被读取；
# 它们由 MEM-002「真实数据层」开始逐步启用，提前列出以便部署环境早做准备。

# ── 应用 ────────────────────────────────────────────────
# 站点公开访问地址，用于生成链接、CSRF/Cookie 的 origin 校验
APP_URL=http://localhost:3000
# 运行环境：development | test | production
NODE_ENV=development

# ── 数据库（MEM-002 启用）──────────────────────────────
# 托管 PostgreSQL 连接串；仅服务端可读，绝不下发到浏览器
DATABASE_URL=postgresql://user:password@host:5432/memories?sslmode=require
# 连接池上限（Serverless/Edge 运行时建议小池 + 外部连接池）
DATABASE_POOL_MAX=5

# ── 会话与安全（MEM-004 启用）──────────────────────────
# 会话 Cookie 签名密钥：至少 32 字节随机值（openssl rand -base64 32）
SESSION_SECRET=replace-with-32-byte-random-value
# 会话有效期（秒）
SESSION_TTL_SECONDS=604800

# ── 门店与演示数据 ─────────────────────────────────────
# 默认演示门店 slug（仅开发/演示环境使用，不要用于生产）
DEMO_VENUE_SLUG=yeshi
# 生产环境是否允许展示 isDemo 演示内容：true | false
ALLOW_DEMO_CONTENT=true

# ── 可观测性（MEM-007 启用）────────────────────────────
# 错误上报 DSN（留空则关闭）
SENTRY_DSN=
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
